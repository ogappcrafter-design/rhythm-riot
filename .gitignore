# Dependencies
node_modules/

# Build output
dist/
dist-ssr/
*.local

# Capacitor native projects (generated by `cap add android`)
android/
ios/

# Editor / OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Audio source stems are large binaries — dropped in per environment.
# Keep the folder + README but ignore the actual track audio.
public/audio/*.mp3
public/audio/*.wav
public/audio/*.ogg
public/audio/*.m4a

# TS build info
*.tsbuildinfo
