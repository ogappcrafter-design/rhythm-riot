# Dependencies
node_modules/

# Build output
dist/
dist-ssr/
*.local

# iOS native project is generated by `cap add ios` (not committed here).
ios/

# The Android project IS committed so it opens straight in Android Studio.
# Its own android/.gitignore excludes build outputs (build/, .gradle, local.properties, keystores).
# Never commit signing keystores or key passwords:
android/**/*.keystore
android/**/*.jks
android/key.properties
android/local.properties

# Editor / OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# TS build info
*.tsbuildinfo

# Intermediate icon/splash PNGs — reproducible from assets/*.svg via `node assets/render.mjs`.
# The generated per-density resources under android/app/src/main/res ARE committed.
assets/*.png
